# EnvioBot Full - Variables de entorno
PORT=5001
FLASK_ENV=development
SECRET_KEY=cambiar_en_produccion_clave_secreta_super_segura
JWT_SECRET_KEY=cambiar_en_produccion_jwt_secret_key

# Base de datos MySQL (DonWeb o Local)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=enviobot_full
DB_PORT=3306

# Integración Oficial MercadoLibre
# App creada en https://developers.mercadolibre.com.ar/
ML_SHARED_CLIENT_ID=TU_CLIENT_ID_DE_MELI
ML_CLIENT_SECRET=TU_CLIENT_SECRET_DE_MELI
ML_REDIRECT_URI=https://enviobot.com.ar/api/ml/callback

# Configuración de Alertas por Email (SMTP DonWeb)
ALERT_SENDER_EMAIL=alertas@enviobot.com.ar
SMTP_HOST=smtp.donweb.com
SMTP_PORT=465
SMTP_USER=alertas@enviobot.com.ar
SMTP_PASSWORD=

# Configuración de WhatsApp (Opción A: Evolution API en DonWeb VPS)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=tu_clave_api_secreta_evolution
EVOLUTION_INSTANCE_NAME=enviobot_full

# Configuración de WhatsApp (Opción B: Gateway HTTP alternativo UltraMsg / W-API)
# WHATSAPP_GATEWAY_URL=https://api.ultramsg.com/instanceXXXX/messages/chat
# WHATSAPP_GATEWAY_TOKEN=tu_token_ultramsg

# Modo Simulación (true para registrar en consola sin mandar mensajes reales en dev)
WHATSAPP_SIMULATION_MODE=false
APP_URL=https://enviobot.com.ar/full

