# EnvioBot Full - Variables de entorno
PORT=5001
FLASK_ENV=development
SECRET_KEY=cambiar_en_produccion_clave_secreta_super_segura
JWT_SECRET_KEY=cambiar_en_produccion_jwt_secret_key

# Base de datos MySQL (DonWeb o Local)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=enviobot_full
DB_PORT=3306

# Integración Oficial MercadoLibre
# App creada en https://developers.mercadolibre.com.ar/
ML_SHARED_CLIENT_ID=TU_CLIENT_ID_DE_MELI
ML_CLIENT_SECRET=TU_CLIENT_SECRET_DE_MELI
ML_REDIRECT_URI=https://enviobot.com.ar/api/ml/callback

# Configuración de Alertas
ALERT_SENDER_EMAIL=alertas@enviobot.com.ar
SMTP_HOST=smtp.donweb.com
SMTP_PORT=465
SMTP_USER=alertas@enviobot.com.ar
SMTP_PASSWORD=
