# ==============================================================================
# Crontab de Producción para EnvioBot Full (DonWeb VPS)
# Para instalar, ejecutar en la terminal de Linux: crontab -e
# y pegar las siguientes líneas (ajustando la ruta a tu servidor si es necesario):
# ==============================================================================

# 1. Sincronización general y disparo de alertas (Cada 4 horas de 08:00 a 20:00)
0 8,12,16,20 * * * /bin/bash /var/www/enviobot-full/backend/cron_runner.sh > /dev/null 2>&1

# 2. Resumen matutino obligatorio (Lunes a Sábado a las 08:30 AM)
# Garantiza que el equipo de depósito y el dueño arranquen el día con la lista de colecta lista
30 8 * * 1-6 /var/www/enviobot-full/backend/venv/bin/python /var/www/enviobot-full/backend/worker.py --alerts-only >> /var/log/enviobot_alerts.log 2>&1

# 3. Limpieza de logs antiguos (Mantiene logs de los últimos 30 días, todos los domingos a las 03:00 AM)
0 3 * * 0 find /var/www/enviobot-full/backend/logs -name "worker_*.log" -type f -mtime +30 -delete
